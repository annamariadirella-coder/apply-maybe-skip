{
  "manifest_version": 3,
  "name": "JobOps",
  "version": "1.0.0",
  "description": "Discover, review and track job opportunities with your own profile.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "apps/extension/src/background/on-installed.js"
  },
  "action": {
    "default_title": "JobOps",
    "default_popup": "apps/extension/src/popup/popup.html"
  },
  "options_ui": {
    "page": "apps/dashboard/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "apps/extension/src/content/job-page-data.js",
        "apps/extension/src/content/job-page-extractor.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
