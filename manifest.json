{
  "manifest_version": 3,
  "name": "Apply, Maybe, Skip",
  "version": "0.1.0",
  "description": "Quickly triage job postings against a candidate profile.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/on-installed.js"
  },
  "action": {
    "default_title": "Apply, Maybe, Skip",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/job-page-extractor.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
